// Schema do Pyla. Os models entram pelas Issues, com spec aprovada (architecture.md §5).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
}
